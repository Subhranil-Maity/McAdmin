# McAdminConsole environment. Copy to .env.local and adjust (.env* files are git-ignored).
#
# VITE_BACKEND_URL - where the browser reaches McAdminWorker. Baked in at build time,
# but overridden at runtime by window.__MCADMIN_CONFIG__.backendUrl in public/config.js.
#   same-origin                     -> use the console's own origin; the dev/preview server
#                                      proxies /api (incl. WebSockets) to MCADMIN_WORKER_URL
#   host:port / http(s)://host:port -> talk to that worker directly (worker CORS must allow it)
#   (empty)                         -> no backend, mock mode
VITE_BACKEND_URL=same-origin

# Dev/preview server only: target of the /api proxy used by "same-origin".
MCADMIN_WORKER_URL=http://127.0.0.1:8000
