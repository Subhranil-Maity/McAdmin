# Build-time fallback for the McAdminWorker URL. Copy to .env.local and adjust.
# Overridden at runtime by window.__MCADMIN_CONFIG__.backendUrl in public/config.js.
#   host:port / http(s)://host:port -> talk to that worker directly
#   same-origin                     -> use the console's own origin (dev: proxied to MCADMIN_WORKER_URL)
#   empty                           -> no backend, mock mode
VITE_BACKEND_URL=127.0.0.1:8000

# Dev/preview server only: where /api (and its WebSockets) is proxied to
# when VITE_BACKEND_URL=same-origin. Defaults to http://127.0.0.1:8000.
# MCADMIN_WORKER_URL=http://127.0.0.1:8000
