ADMIN_WORKER_HOST=0.0.0.0
ADMIN_WORKER_PORT=8000
HOME_DIR=/minecraft
RCON_HOST=127.0.0.1
JWT_SECRET=replace_with_a_secure_jwt_secret

# --- Web console (optional) ---
# Serve the built McAdminConsole (`bun run build` -> McAdminConsole/dist) from the
# worker, so the console and the API share one origin and port. Unset = API only.
# start.sh sets this automatically in production mode.
# WEB_ROOT=../McAdminConsole/dist
# backendUrl handed to the console via /config.js (default: same-origin).
# WEB_BACKEND_URL=same-origin

# --- CORS (optional) ---
# Comma-separated origins allowed to call the API from another origin, e.g. the
# Vite dev server. Unset = mirror any origin (permissive, convenient for dev).
# Not needed when the worker serves the console itself (same origin).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://vanguard.local:3000
